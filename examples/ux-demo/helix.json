{
 "helix_version": "0.9.3-beta",
 "test_cmd": "true",
 "ux": {
  "enabled": true,
  "start_cmd": "python3 -m http.server 4180 --bind 127.0.0.1 -d app",
  "base_url": "http://127.0.0.1:4180/",
  "pages": [
   {
    "name": "logowanie",
    "path": "/"
   },
   {
    "name": "zamowienia",
    "path": "/zamowienia.html",
    "wait_for": "#rows tr"
   },
   {
    "name": "nowe",
    "path": "/nowe.html"
   }
  ],
  "api_pattern": "**/api/**",
  "flows": "ux-flows.yaml",
  "judge": {
   "provider": "gemini-flash",
   "targets": [
    "phone-small@portrait",
    "fold-open@portrait",
    "desktop/chromium"
   ]
  },
  "explore": {
   "provider": "gemini-flash",
   "devices": [
    "phone-small@portrait"
   ],
   "max_steps": 10
  }
 },
 "providers": {
  "fallback": "grok-cli"
 }
}