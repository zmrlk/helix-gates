#!/usr/bin/env python3
"""helix-gates (DRAFT, box version) - Shopify-Helix-style checkpoint + gate loop.

Subcommands: plan, run, gate (behavior|visual|review|truth|ux), truth (init|suite|check), ux (scan|flows|explore|judge|report|all|devices),
coverage, evidence, approve, reject, status, providers.
Run inside the target git repo (or pass --repo). Config: <repo>/helix.json (optional).
"""
import helix_workflow
import argparse, datetime as dt, json, os, re, shutil, signal, subprocess, sys, threading, time, urllib.request
from pathlib import Path
from functools import partial
from helix_paths import normalize, relative as relative_path, within

HELIX_HOME = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HELIX_HOME / "bin"))
PROMPTS, SCHEMAS = HELIX_HOME / "prompts", HELIX_HOME / "schemas"
PW_PATH = os.environ.get("HELIX_PLAYWRIGHT", "playwright")

DEFAULT_CFG = {
    "test_cmd": None,                      # None = auto-detect
    "architecture_doc": None,              # e.g. ARCHITECTURE.md / AGENTS.md / CLAUDE.md (auto)
    "mode": "supervised",                  # supervised | autonomous
    "providers": {
        "planner": "codex",
        "implementer": "codex",
        "reviewers": [
            {"name": "A-architecture", "provider": "codex", "prompt": "review_architecture"},
            {"name": "B-tests-security", "provider": "gemini", "prompt": "review_tests"},
            {"name": "C-architecture", "provider": "claude-via-agy", "prompt": "review_architecture", "enabled": False},
        ],
        "visual_judge": "gemini",
        "fallback": "codex",
    },
    "models": {
        "codex": [None],                                           # None = codex default model
        "gemini": ["gemini-4-argon-high", "gemini-3.8-flash-high"],
        "claude-via-agy": ["claude-opus-5-5-high", "claude-sonnet-5-5-high"],
        "claude": [None],
        "grok-cli": ["grok-4.7", "grok-4.6"],
        "gemini-flash": ["gemini-3.8-flash-low", "gemini-3.8-flash-high"],   # fast vision model (UX explorer); low: 6 s na krok, high: 34-51 s i puste odpowiedzi (pomiar 15.11)
    },
    "visual": {"enabled": False, "start_cmd": None, "url": None, "reference_url": None,
               "reference_image": None, "viewport": [1280, 800], "actions": [], "ready_timeout_s": 60},
    "packs": {"security": {"deep_required": False}},
    "truth": {"required": False, "checker": "gemini"},   # G0 "Prawda i kontekst"; required=True blocks approve/commit
    "limits": {"max_attempts": 3, "max_review_rounds": 2, "checkpoint_timeout_s": 1800,
               "provider_timeout_s": 600, "grok_wait_s": 0},
}

import helix_ux                                    # UX quality pack (bin/helix_ux.py)
helix_ux.H = sys.modules[__name__]
