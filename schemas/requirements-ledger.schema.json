{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ledger wymagań Helixa",
  "type": "object",
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "text",
          "priority",
          "sources",
          "acceptance",
          "status",
          "tests",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[A-Z]-\\d{2,}$"
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "MUST",
              "SHOULD"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file",
                "quote"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "message_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "acceptance": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "partial",
              "missing",
              "in-progress"
            ]
          },
          "tests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "waiver": {
            "type": "object",
            "required": [
              "owner",
              "reason",
              "date"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "enum": [
                  "Owner"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "additionalProperties": false
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "merged_into": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "waivers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner",
          "reason",
          "date"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "enum": [
              "Owner"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
