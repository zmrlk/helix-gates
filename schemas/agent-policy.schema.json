{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "helix_version": {
      "type": "string",
      "minLength": 1
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibitions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,79}"
          },
          "kind": {
            "type": "string",
            "enum": [
              "forbidden_file",
              "forbidden_pattern",
              "required_pattern"
            ]
          },
          "glob": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diff_base": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "helix_version",
    "conventions",
    "gates",
    "test_commands",
    "prohibitions"
  ]
}
